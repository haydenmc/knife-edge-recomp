+bool ultramodern::terminate_game_threads() {
+    using namespace std::chrono_literals;
+
+    {
+        // Setting the flag under the lock is what gives the loop below its
+        // termination argument: from here on, a game thread can only be
+        // registered by another game thread that is itself still registered
+        // (osCreateThread rejects the call otherwise), so an empty registry
+        // really does mean "no game thread can appear any more".
+        std::lock_guard lock{ game_thread_mutex };
+        ultramodern::game_threads_terminating.store(true, std::memory_order_relaxed);
+    }
+
+    // Wake every game thread repeatedly until none is left running. A single
+    // broadcast is not enough: a thread that was between two blocking points
+    // when it was woken consumes the wakeup without ever waiting on it, and a
+    // thread that has not reached a termination check yet can still be part way
+    // through a scheduling operation.
+    //
+    // The deadline exists because a game thread that busy-waits without ever
+    // reaching a yield point can never be woken at all. Giving up is reported
+    // to the caller so that it can decline to free memory those threads are
+    // still using; hanging forever would be worse than leaking.
+    constexpr auto termination_deadline = 5s;
+    const auto give_up_at = std::chrono::steady_clock::now() + termination_deadline;
+    size_t unstoppable = 0;
+
+    while (true) {
+        std::vector<UltraThreadContext*> live;
+        {
+            std::lock_guard lock{ game_thread_mutex };
+            live = live_game_threads;
+        }
+        if (live.empty()) {
+            break;
+        }
+        if (std::chrono::steady_clock::now() >= give_up_at) {
+            unstoppable = live.size();
+            break;
+        }
+        for (UltraThreadContext* context : live) {
+            // A parked thread is blocked on its own semaphore in
+            // wait_for_resumed(), which checks for termination on wake.
+            context->running.signal();
+            // The thread that currently holds execution may instead be blocked
+            // on the external message queue; post one wakeup per live thread so
+            // that there is always at least one for whoever is waiting there.
+            ultramodern::post_external_message_wakeup();
+        }
+        std::this_thread::sleep_for(1ms);
+    }
+
+    // Every thread that unwound during termination left its context here for us
+    // rather than for the thread cleaner (which stops as soon as the runtime is
+    // exiting, and so cannot be relied on at this point).
+    std::vector<UltraThreadContext*> finished;
+    {
+        std::lock_guard lock{ game_thread_mutex };
+        finished.swap(terminated_game_threads);
+    }
+    for (UltraThreadContext* context : finished) {
+        context->host_thread.join();
+        delete context;
+    }
+
+    // A thread that happened to finish on its own after the cleaner stopped but
+    // before termination began is sitting in the cleaner's queue with nobody
+    // left to join it. Take those too.
+    UltraThreadContext* leftover;
+    while (deleted_threads.try_dequeue(leftover)) {
+        leftover->host_thread.join();
+        delete leftover;
+    }
+
+    if (unstoppable != 0) {
+        fprintf(stderr,
+            "[Shutdown] %zu game thread(s) could not be stopped; leaving their memory allocated\n",
+            unstoppable);
+        return false;
+    }
+
+    debug_printf("[Shutdown] Stopped and joined %zu game thread(s)\n", finished.size());
+    return true;
+}
