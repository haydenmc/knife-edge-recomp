 struct thread_terminated : std::exception {};
 
+// Orderly termination of the game's threads.
+//
+// Game threads are cooperatively scheduled and, being the recompiled output of
+// a game that never expected to exit, they never return on their own: they are
+// either parked on their own semaphore, blocked waiting for an external
+// message, or running recompiled code that will come back to one of those two
+// states. Nothing in a normal quit stops them, so without this they keep
+// reading and writing RDRAM while the runtime tears itself down and frees it.
+//
+// They are stopped by making every point at which a game thread can block or
+// yield throw `thread_terminated` once the flag below is set. That exception
+// unwinds out of recompiled code exactly as osDestroyThread's self-destroy
+// already does, and is caught by the thread wrapper.
+//
+// The flag is written exactly once and read on the scheduler's hot path, so
+// reads are relaxed: nothing is published through it, and a thread that
+// observes it late merely terminates one yield later.
+extern std::atomic_bool game_threads_terminating;
+
+inline bool is_terminating() {
+    return game_threads_terminating.load(std::memory_order_relaxed);
+}
+
+// Throws `thread_terminated` if termination has begun. Callers must place this
+// so that no RDRAM access can happen between the check and the throw.
+inline void check_terminating() {
+    if (is_terminating()) {
+        throw thread_terminated{};
+    }
+}
+
+// Sets the termination flag, wakes every game thread until none is left
+// running, and joins their host threads. Call it while everything the game
+// threads use (RDRAM above all) is still valid.
+//
+// Returns false if a game thread could not be stopped before the internal
+// deadline expired -- which can only happen if it is spinning without ever
+// reaching a yield point -- in which case the caller must not free RDRAM.
+bool terminate_game_threads();
