+// ---------------------------------------------------------------------------
+// Registry of live game threads, used to shut them down in an orderly way. See
+// the comment on ultramodern::terminate_game_threads in ultramodern.hpp.
+// ---------------------------------------------------------------------------
+
+std::atomic_bool ultramodern::game_threads_terminating = false;
+
+namespace {
+    // Guards everything in this block, and is also held while the termination
+    // flag is set so that "flag is set" and "registry contents" are consistent
+    // with each other for a thread that is being created or destroyed. Only
+    // taken on thread creation and destruction, never on a scheduling path.
+    std::mutex game_thread_mutex;
+
+    // Contexts of game threads whose thread function has not returned yet, i.e.
+    // exactly the threads that may still access RDRAM.
+    std::vector<UltraThreadContext*> live_game_threads;
+
+    // Contexts of game threads that finished during termination. The thread
+    // cleaner has already stopped by then, so terminate_game_threads() joins
+    // and deletes these itself.
+    std::vector<UltraThreadContext*> terminated_game_threads;
+
+    // Registers a new game thread and spawns its host thread, both under the
+    // lock that guards the termination flag. Doing them together is what makes
+    // it impossible to spawn a game thread after terminate_game_threads() has
+    // decided which threads it has to wait for. Returns false if termination
+    // has already begun, in which case nothing was spawned.
+    template <typename F>
+    bool register_and_start_game_thread(UltraThreadContext* context, F&& thread_body) {
+        std::lock_guard lock{ game_thread_mutex };
+        if (ultramodern::is_terminating()) {
+            return false;
+        }
+        context->host_thread = std::thread{ std::forward<F>(thread_body) };
+        live_game_threads.push_back(context);
+        return true;
+    }
+
+    // Deregisters a game thread that has finished running. Returns true if the
+    // context was handed to terminate_game_threads() to join, false if the
+    // caller should dispose of it the normal way (the thread cleaner).
+    bool deregister_game_thread(UltraThreadContext* context) {
+        std::lock_guard lock{ game_thread_mutex };
+        live_game_threads.erase(
+            std::remove(live_game_threads.begin(), live_game_threads.end(), context),
+            live_game_threads.end());
+        if (ultramodern::is_terminating()) {
+            terminated_game_threads.push_back(context);
+            return true;
+        }
+        return false;
+    }
+}
