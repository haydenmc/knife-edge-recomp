# --- Never commit the ROM or asset/data dumps ---
*.n64
*.z64
*.v64
*.rom
/build*/

# Recompiler output is a build artifact, not source. Regenerate with a ROM:
#   make -C analysis recomp     (or configure with -DKE_ROM=<path>)
# The reviewable source of truth is config/knife_edge.us.syms.toml.
/generated/

# Runtime app data (user config, saves, ROM cache) created next to the binary.
/ke_recomp_data/

# Tooling noise
.venv/
__pycache__/
*.pyc
.cache/
compile_commands.json
.vscode/

# Screenshots/captures are rendered game content - keep them out of the repo.
*.png
*.jpg
*.wav
*.pcm

# Flatpak build output (bundle + flatpak-builder work dir) — binary artifacts,
# never committed (same policy as every other build output).
*.flatpak
/build-flatpak/
