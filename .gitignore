# --- Never commit the ROM or asset/data dumps ---
*.n64
*.z64
*.v64
*.rom
/build*/

# Recompiler output is a build artifact, not source. Regenerate with a ROM:
#   make -C analysis recomp     (or configure with -DKE_ROM=<path>)
# The reviewable source of truth is config/knife_edge.us.syms.toml.
/generated/

# Tooling noise
.venv/
__pycache__/
*.pyc
.cache/
compile_commands.json
.vscode/

# Screenshots/captures are rendered game content - keep them out of the repo.
*.png
*.jpg
*.wav
*.pcm
